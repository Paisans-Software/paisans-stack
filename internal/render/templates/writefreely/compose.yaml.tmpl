# Rendered by paisans. Do not edit: `paisans apply` overwrites this file.
#
# This is the writefreely-wisp fork, not upstream WriteFreely. The fork keeps
# its data in Postgres and its uploads in Garage, so it joins the same cluster
# and the same object store as everything else instead of a SQLite file and a
# local disk nothing else can reach.
{{- if .App.Pinned }}
# {{ .App.Name }} is pinned to {{ .App.Site }}: app, database and media
# together. A half pinned app needs both its own location and the cluster site
# to be reachable, which makes it less available than either alone.
{{- else }}
# {{ .App.Name }} has cluster placement: no Postgres service of its own, and a
# connection to the local HAProxy on {{ .DBHost }}:{{ .DBPort }}.
{{- end }}
name: paisans-{{ .App.Name }}

services:
  app:
    image: {{ .Image "app" }}
    restart: unless-stopped
    ports:
      - "{{ .App.Port }}:{{ .App.Port }}"
    volumes:
      - {{ .DataPath }}/data:/data
      # WriteFreely reads a file, not an environment. Its SSO client secret is
      # in here, which is why it is bind mounted at 0600 rather than passed as
      # environment: `docker inspect` and /proc/<pid>/environ would show the
      # latter.
      - {{ .DataPath }}/config.ini:/data/config.ini:ro
{{- if .App.Pinned }}
    depends_on:
      - postgres

  postgres:
    image: {{ .Image "postgres" }}
    restart: unless-stopped
    environment:
      POSTGRES_DB: {{ .DBName }}
      POSTGRES_USER: {{ .DBUser }}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:?set in .env}
    volumes:
      - {{ .DataPath }}/postgres:/var/lib/postgresql/data
{{- end }}
