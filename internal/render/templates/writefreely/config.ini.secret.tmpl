; Rendered by paisans. Do not edit.
;
; A build artifact: `paisans apply` renders it and refuses to overwrite one
; that has been modified locally. Change paisans.yaml or secrets.enc.yaml.
;
; A changed file needs a restart at most, not a recreate: the container reads
; it at startup and keeps its identity.

[server]
hidden_host =
port = {{ .App.Port }}
bind = 0.0.0.0
autocert = false

[database]
; Postgres, the same cluster everything else uses. A pinned blog talks to the
; Postgres container beside it; a clustered one talks to the local HAProxy,
; which is what .DBHost already resolves for every other kind.
;
; tls is false because the connection does not leave the host: the fork maps
; true to sslmode=require and false to sslmode=disable, so this is the
; difference between requiring TLS to a local socket and not.
type = postgres
host = {{ .DBHost }}
port = {{ .DBPort }}
database = {{ .DBName }}
username = {{ .DBUser }}
password = {{ .DBPassword }}
tls = false

[storage]
; Uploaded images live in Garage rather than on the container's disk, so a
; clustered blog does not pin itself to one node by its own uploads.
;
; This bucket is NOT public, and that is not an oversight. The fork streams
; images through its own /uploads/ route with http.ServeContent, from
; whichever store is configured, and never emits or presigns an S3 URL.
; Nothing anonymous ever reaches this bucket, so it gets no website access
; and no route on the media hostname.
;
; s3_virtual_host is left at its default, which is path style, because that
; is what Garage needs.
type = s3
s3_endpoint = {{ .S3.Endpoint }}
s3_region = {{ .S3.Region }}
s3_bucket = {{ .S3.Bucket }}
s3_access_key_id = {{ .S3.AccessKeyID }}
s3_secret_access_key = {{ .S3.SecretKey }}

[app]
site_name = {{ .Setting "site_name" .App.Name }}
host = {{ .PublicURL }}
theme = {{ .Setting "theme" "write" }}
single_user = false
open_registration = false
federation = {{ yesno (.SettingBool "federation" true) }}
public_stats = false
private = {{ yesno (.SettingBool "private" true) }}
local_timeline = true
{{- if .OIDC.Present }}
; Sign in is the identity provider's, so the local password path is closed.
disable_password_auth = true

[oauth.generic]
client_id = {{ .OIDC.ClientID }}
client_secret = {{ .OIDC.ClientSecret }}
host = {{ .OIDC.Issuer }}
display_name = {{ .Setting "oidc_display_name" "OpenID Connect" }}
; Paths, not URLs: WriteFreely appends each to `host` above.
auth_endpoint = {{ .OIDC.AuthorizationPath }}
token_endpoint = {{ .OIDC.TokenPath }}
inspect_endpoint = {{ .OIDC.UserinfoPath }}
scope = openid profile email
map_user_id = sub
map_username = preferred_username
map_display_name = name
map_email = email
allow_disconnect = false
{{- end }}
