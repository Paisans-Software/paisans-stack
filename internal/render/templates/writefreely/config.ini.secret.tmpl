; Rendered by paisans. Do not edit.
;
; A build artifact: `paisans apply` renders it and refuses to overwrite one
; that has been modified locally. Change paisans.yaml or secrets.enc.yaml.
;
; A changed file needs a restart at most, not a recreate: the container reads
; it at startup and keeps its identity.

[server]
hidden_host =
port = {{ .App.Port }}
bind = 0.0.0.0
autocert = false

[database]
; Postgres, the same cluster everything else uses. A pinned blog talks to the
; Postgres container beside it; a clustered one talks to the local HAProxy,
; which is what .DBHost already resolves for every other kind.
;
; tls is false because the connection does not leave the host: the fork maps
; true to sslmode=require and false to sslmode=disable, so this is the
; difference between requiring TLS to a local socket and not.
type = postgres
host = {{ .DBHost }}
port = {{ .DBPort }}
database = {{ .DBName }}
username = {{ .DBUser }}
password = {{ .DBPassword }}
tls = false

[uploads]
; Image uploads are off in the fork unless this says otherwise, and the
; default is false. Without it POST /api/me/images is not routed at all, the
; /uploads/ route is gated off, and the [storage] block above is provisioned
; but never read: a bucket, a key and a grant that nothing uses.
;
; It also turns on the startup check. checkUploadsAtStartup is itself gated on
; uploads being enabled, so with uploads off a wrong bucket or a refused key is
; not reported at boot either, and the first signal an operator gets is a
; failed upload much later.
;
; dir is deliberately absent. It names a path on this node and only the local
; image store reads it; with [storage] type = s3 below, nothing consults it.
enabled = true
; A bound on one file, not on a writer's total storage. Rendered rather than
; omitted: an absent key leaves Go's zero value, which the fork's setting
; registry rejects and replaces with its default, logging an ERROR on every
; boot while doing it.
max_size_mb = {{ .Setting "uploads_max_size_mb" "10" }}

[storage]
; Uploaded images live in Garage rather than on the container's disk, so a
; clustered blog does not pin itself to one node by its own uploads.
;
; This bucket IS public, to anyone holding a link. With type = s3 the fork
; writes images here and never reads them back to serve them: it requires
; image_url_base, publishes every image URL under it, and answers its own
; /uploads/ route with a redirect there. image_url_base is this app's own
; media hostname, which the gateway sends to Garage's web endpoint for this
; bucket, so the bucket has website access. It is the hostname alone, with no
; path, because the gateway resolves the bucket from the hostname and the
; fork appends the object key with a slash.
;
; image_url_base needs a fork build that has it (writefreely-wisp#171). A
; build from before it does not read the key, keeps streaming images through
; /uploads/ from this bucket with its own credential, and so still works; it
; just does not use the media hostname.
;
; s3_virtual_host is rendered rather than left to the fork's default. Garage
; needs path style addressing (endpoint/bucket/key), which is what false
; means; relying on a default would make a future fork release that flipped it
; break every image silently.
type = s3
s3_endpoint = {{ .S3.Endpoint }}
s3_region = {{ .S3.Region }}
s3_bucket = {{ .S3.Bucket }}
s3_access_key_id = {{ .S3.AccessKeyID }}
s3_secret_access_key = {{ .S3.SecretKey }}
s3_virtual_host = false
image_url_base = {{ .S3.PublicBase }}

[app]
site_name = {{ .Setting "site_name" .App.Name }}
host = {{ .PublicURL }}
theme = {{ .Setting "theme" "write" }}
single_user = false
open_registration = false
; Rendered for the same reason as max_size_mb: the fork's registry rejects the
; zero an absent key leaves behind, and logs an ERROR on every boot.
min_username_len = {{ .Setting "min_username_len" "3" }}
federation = {{ yesno (.SettingBool "federation" true) }}
public_stats = false
private = {{ yesno (.SettingBool "private" true) }}
local_timeline = true
{{- if .OIDC.Present }}
; Sign in is the identity provider's, so the local password path is closed.
disable_password_auth = true

[oauth.generic]
client_id = {{ .OIDC.ClientID }}
client_secret = {{ .OIDC.ClientSecret }}
host = {{ .OIDC.Issuer }}
display_name = {{ .Setting "oidc_display_name" "OpenID Connect" }}
; Paths, not URLs: WriteFreely appends each to `host` above.
auth_endpoint = {{ .OIDC.AuthorizationPath }}
token_endpoint = {{ .OIDC.TokenPath }}
inspect_endpoint = {{ .OIDC.UserinfoPath }}
scope = openid profile email
map_user_id = sub
map_username = preferred_username
map_display_name = name
map_email = email
allow_disconnect = false
{{- end }}
