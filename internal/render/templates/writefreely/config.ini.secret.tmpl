; Rendered by paisans. Do not edit.
;
; A build artifact: `paisans apply` renders it and refuses to overwrite one
; that has been modified locally. Change paisans.yaml or secrets.enc.yaml.
;
; A changed file needs a restart at most, not a recreate: the container reads
; it at startup and keeps its identity.

[server]
hidden_host =
port = {{ .App.Port }}
bind = 0.0.0.0
autocert = false

[database]
; SQLite, in the app's own data directory. See the note in compose.yaml.
type = sqlite3
filename = writefreely.db

[app]
site_name = {{ .Setting "site_name" .App.Name }}
host = {{ .PublicURL }}
theme = {{ .Setting "theme" "write" }}
single_user = false
open_registration = false
federation = {{ yesno (.SettingBool "federation" true) }}
public_stats = false
private = {{ yesno (.SettingBool "private" true) }}
local_timeline = true
{{- if .OIDC.Present }}
; Sign in is the identity provider's, so the local password path is closed.
disable_password_auth = true

[oauth.generic]
client_id = {{ .OIDC.ClientID }}
client_secret = {{ .OIDC.ClientSecret }}
host = {{ .OIDC.Issuer }}
display_name = {{ .Setting "oidc_display_name" "OpenID Connect" }}
; Paths, not URLs: WriteFreely appends each to `host` above.
auth_endpoint = {{ .OIDC.AuthorizationPath }}
token_endpoint = {{ .OIDC.TokenPath }}
inspect_endpoint = {{ .OIDC.UserinfoPath }}
scope = openid profile email
map_user_id = sub
map_username = preferred_username
map_display_name = name
map_email = email
allow_disconnect = false
{{- end }}
