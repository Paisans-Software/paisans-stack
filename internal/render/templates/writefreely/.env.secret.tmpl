# Rendered by paisans. Do not edit.
#
# The fork itself reads no environment: everything it needs is in
# config.ini, bind mounted and 0600. This file exists only so that
# `paisans apply` can set the Postgres container's own password without
# writing a credential into compose.yaml, which is 0644. Compose reads a
# ".env" file in the project directory for ${VAR} substitution whether or
# not a service declares env_file, which is what lets compose.yaml below
# refer to POSTGRES_PASSWORD without carrying it.
#
# Changing this recreates the database container.
{{- if .App.Pinned }}
POSTGRES_PASSWORD={{ .DBPassword }}
{{- end }}
