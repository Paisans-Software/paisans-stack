# Rendered by paisans. Do not edit: `paisans apply` overwrites this file.
#
# Every clustered application on this site connects to this HAProxy at
# {{ .Address }}:{{ .ClusterPort }}, this site's own mesh address, from the first
# install. This backend list starts with one entry and grows when a site is
# added. No application configuration changes, ever: that one indirection is
# what makes a second site an operation rather than a project.
#
# The mesh address, not only loopback, because the applications run in bridge
# networked containers, where 127.0.0.1 is the container itself. Loopback is
# kept for a tool run on the host.
global
    maxconn 500

defaults
    log     global
    mode    tcp
    retries 2
    timeout client  30m
    timeout connect 4s
    timeout server  30m
    timeout check   5s

listen postgres
    bind 127.0.0.1:{{ .ClusterPort }}
    bind {{ .Address }}:{{ .ClusterPort }}
    option httpchk GET /primary
    http-check expect status 200
    default-server inter 3s fall 3 rise 2 on-marked-down shutdown-sessions
{{- range .ClusterMembers }}
    server {{ .Name }} {{ .Address }}:{{ $.PostgresPort }} maxconn 100 check port {{ $.PatroniAPIPort }}
{{- end }}

# Which backend HAProxy routes to, as CSV at /stats;csv, for `paisans site
# add` to check that only the primary is UP. Loopback only, and this is
# HAProxy's host network, so nothing off the machine can read it.
listen stats
    mode http
    bind 127.0.0.1:{{ .StatsPort }}
    stats enable
    stats uri /stats
