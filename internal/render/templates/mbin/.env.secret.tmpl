# Rendered by paisans. Do not edit.
#
# This file is a build artifact. `paisans apply` renders it from paisans.yaml
# and secrets.enc.yaml and refuses to overwrite one that has been modified
# locally, so an edit here is lost work at best. Change the source instead.
#
# Changing a value means recreating the container. Compose passes environment
# at start, so `docker compose restart` will not pick it up.
PAISANS_APP={{ .App.Name }}
PAISANS_SITE={{ .App.Site }}
SERVER_NAME={{ .Hostname }}
KBIN_DOMAIN={{ .Hostname }}
TRUSTED_PROXIES={{ .TrustedProxies }}
DATABASE_URL={{ .DSN }}
MERCURE_JWT_SECRET={{ .Secret "mercure_jwt_secret" }}
RABBITMQ_PASSWORD={{ .Secret "rabbitmq_password" }}
VALKEY_PASSWORD={{ .Secret "valkey_password" }}
{{- if .App.Pinned }}
POSTGRES_PASSWORD={{ .DBPassword }}
{{- end }}
# Object storage. These are inert on their own: the adapter binding in
# config/packages/oneup_flysystem.yaml is what decides whether they are used.
S3_KEY={{ .S3.AccessKeyID }}
S3_SECRET={{ .S3.SecretKey }}
S3_BUCKET={{ .S3.Bucket }}
S3_REGION={{ .S3.Region }}
S3_ENDPOINT={{ .S3.Endpoint }}
{{- if .OIDC.Present }}
# Single sign on, pointed straight at the identity provider. Every endpoint is
# discovered from {issuer}/.well-known/openid-configuration, so the issuer is
# the only URL to set, and the client's callback at the provider must be
# {{ .PublicURL }}/oauth/oidc/verify.
#
# Upstream Mbin ships named providers (keycloak, zitadel, authentik) and no
# generic OIDC one, so these variables need an image that has added it. Declare
# it under `images` for this app. Without such an image they are inert, and the
# instance has no way to sign in through the provider.
OAUTH_OIDC_ISSUER={{ .OIDC.Issuer }}
OAUTH_OIDC_ID={{ .OIDC.ClientID }}
OAUTH_OIDC_SECRET={{ .OIDC.ClientSecret }}
{{- end }}
