# Rendered by paisans. Do not edit: `paisans apply` overwrites this file.
#
# This deployment's mesh interface exists from the first install, with an
# empty peer list at one site. Every service binds to this address, so joining
# a site only adds peers: no service is reconfigured and no address changes.
[Interface]
Address = {{ .Site.Address }}/{{ .MeshPrefix }}
{{- if .ListenPort }}
# The port of this site's endpoint, which every other site dials.
ListenPort = {{ .ListenPort }}
{{- end }}
PrivateKey = {{ .PrivateKey }}
{{- if .IsRelay }}
# This site has a stable endpoint, so it relays traffic between sites that
# have none: two sites behind NAT with changing addresses cannot dial each
# other.
PostUp = sysctl -w net.ipv4.ip_forward=1
{{- end }}
{{- range .Peers }}

[Peer]
# {{ .Name }}
PublicKey = {{ .PublicKey }}
AllowedIPs = {{ .AllowedIPs }}
{{- if .Endpoint }}
Endpoint = {{ .Endpoint }}
# Keeps the NAT mapping open from the side that dials out.
PersistentKeepalive = 25
{{- end }}
{{- end }}
