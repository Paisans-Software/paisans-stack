# Rendered by paisans. Do not edit.
#
# A build artifact: `paisans apply` renders it and refuses to overwrite one
# that has been modified locally. Change paisans.yaml or secrets.enc.yaml.
#
# Shared by both the provisional and the members instance: the same Pocket ID
# client, the same cookie secret and the same cookie domain, so members can
# read the session cookie provisional already wrote. Splitting either of those
# across the two containers would give them two different sessions and every
# member a second login.
#
# Variable names follow oauth2-proxy's own configuration reference
# (https://oauth2-proxy.github.io/oauth2-proxy/configuration/overview, the
# OIDC provider and cookie sections) and rsync/authgate/compose.yaml plus its
# .env.example in paisans.community, the deployment this kind generalises.
PAISANS_APP={{ .App.Name }}
PAISANS_SITE={{ .App.Site }}

# Discovery, not hand written endpoint URLs: the identity provider's endpoints
# share no common prefix and must never be assumed.
OAUTH2_PROXY_PROVIDER=oidc
OAUTH2_PROXY_OIDC_ISSUER_URL={{ .OIDC.Issuer }}
OAUTH2_PROXY_CLIENT_ID={{ .OIDC.ClientID }}
OAUTH2_PROXY_CLIENT_SECRET={{ .OIDC.ClientSecret }}
# `groups` carries membership as both a scope and a claim, but oauth2-proxy
# will not request it implicitly.
OAUTH2_PROXY_SCOPE=openid profile email groups
# oauth2-proxy does not infer PKCE from discovery; it must be asked for
# explicitly, and the identity provider's client must be configured to match.
OAUTH2_PROXY_CODE_CHALLENGE_METHOD=S256
# Not the identity here, so any domain is accepted.
OAUTH2_PROXY_EMAIL_DOMAINS=*

# Scoped to the community's own domain with a leading dot, so one login covers
# every current and future subdomain. Host scoping the cookie would mean a
# login screen per hostname.
OAUTH2_PROXY_COOKIE_DOMAINS=.{{ .Domain }}
# Post-login redirects are only honoured back to the community's own domain,
# or ?rd= would be an open redirect into anyone's site.
OAUTH2_PROXY_WHITELIST_DOMAINS=.{{ .Domain }}
# 32 random bytes, URL-safe base64 encoded without padding: oauth2-proxy
# base64-decodes a cookie secret when the alphabet allows it and measures the
# decoded length, which must be 16, 24 or 32 bytes. This generator's alphabet
# never emits `+` or `/`, so it decodes rather than being taken literally, and
# 32 raw bytes is a length oauth2-proxy accepts.
OAUTH2_PROXY_COOKIE_SECRET={{ .Secret "cookie_secret" }}
OAUTH2_PROXY_COOKIE_SECURE=true
# Lax, not Strict: the browser arrives back here as a cross-site top-level
# navigation after the identity provider redirects it, and Strict would
# refuse to send the cookie on that request.
OAUTH2_PROXY_COOKIE_SAMESITE=lax
OAUTH2_PROXY_COOKIE_EXPIRE=168h
OAUTH2_PROXY_COOKIE_REFRESH=1h

# Caddy sets X-Forwarded-* on every forward_auth subrequest, and this is
# scoped to the mesh, the only thing that can reach this container at all.
OAUTH2_PROXY_REVERSE_PROXY=true
OAUTH2_PROXY_TRUSTED_PROXY_IPS={{ .TrustedProxies }}
OAUTH2_PROXY_SKIP_PROVIDER_BUTTON=true
# Identity for the app behind the gate, surfaced as X-Auth-Request-*. Any
# service consuming these headers must trust nothing upstream of Caddy, since
# Caddy's own forward_auth handling is what strips a forged one on the way in.
OAUTH2_PROXY_SET_XAUTHREQUEST=true
