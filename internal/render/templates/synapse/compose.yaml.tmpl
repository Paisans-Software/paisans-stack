# Rendered by paisans. Do not edit: `paisans apply` overwrites this file.
#
# Three containers, and the split between the first two is the whole design:
# `mas` owns authentication and `app` is a resource server that introspects the
# tokens it issues. The identity provider is upstream of `mas`, never of `app`.
#
{{- if .App.Pinned }}
# {{ .App.Name }} is pinned to {{ .App.Site }}: app, database and media
# together. Synapse is the app this placement exists for, because its media
# store cannot be moved into object storage: the S3 storage provider
# supplements a local media directory rather than replacing it.
{{- else }}
# {{ .App.Name }} has cluster placement: no Postgres service of its own, and a
# connection to the local HAProxy on {{ .DBHost }}:{{ .DBPort }}.
#
# Its media directory is still node local, so a promoted site does not have it
# unless something else replicates it. That is a decision to make rather than
# to discover during a failover.
{{- end }}
name: paisans-{{ .App.Name }}

services:
  app:
    image: {{ .Image "app" }}
    restart: unless-stopped
    env_file:
      - .env
    ports:
      - "{{ .App.Port }}:{{ .App.Port }}"
    volumes:
      - {{ .DataPath }}/data:/data
      # Synapse reads a file. The database password and the secret it shares
      # with MAS are in it, which is why it is bind mounted at 0600 rather than
      # passed as environment: `docker inspect` and /proc/<pid>/environ would
      # show the latter.
      - {{ .DataPath }}/homeserver.yaml:/data/homeserver.yaml:ro
{{- if .App.Pinned }}
    depends_on:
      - postgres
{{- end }}

  mas:
    image: {{ .Image "mas" }}
    restart: unless-stopped
    # The image's entrypoint is mas-cli, so the subcommand is the command.
    # `server` migrates its database and syncs the upstream provider out of
    # mas.yaml on start unless told not to, and it is not told not to, so
    # bringing this stack up needs no second command.
    command: ["server", "--config", "/data/mas.yaml"]
    ports:
      - "{{ .MASPort }}:{{ .MASPort }}"
    volumes:
      # 0600, and for a stronger reason than the homeserver's file: this one
      # carries the signing key, the encryption secret and the identity
      # provider's client secret.
      - {{ .DataPath }}/mas.yaml:/data/mas.yaml:ro
{{- if .App.Pinned }}
    depends_on:
      - postgres

  postgres:
    image: {{ .Image "postgres" }}
    restart: unless-stopped
    environment:
      POSTGRES_DB: {{ .DBName }}
      POSTGRES_USER: {{ .DBUser }}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:?set in .env}
      # Synapse refuses to start against a database with any other collation,
      # unless allow_unsafe_locale is set. Getting this wrong costs a dump and
      # reload later, so it is set at creation.
      POSTGRES_INITDB_ARGS: "--encoding=UTF8 --lc-collate=C --lc-ctype=C"
    volumes:
      - {{ .DataPath }}/postgres:/var/lib/postgresql/data
      # Creates MAS's database beside the homeserver's. Read only when the data
      # directory is empty, so it applies exactly once, at the first `up`.
      - {{ .DataPath }}/initdb.d:/docker-entrypoint-initdb.d:ro
{{- end }}
