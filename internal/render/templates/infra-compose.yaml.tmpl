# Rendered by paisans. Do not edit: `paisans apply` overwrites this file.
#
# Infrastructure for site {{ .Site.Name }}. Bind mounts under /srv, never named
# volumes, so relocating a stack is a tar rather than a volumes-from dance.
name: paisans-infra

services:
{{- if .Site.IsEtcd }}
  etcd:
    image: gcr.io/etcd-development/etcd:v3.5.16
    restart: unless-stopped
    network_mode: host
    command:
      - /usr/local/bin/etcd
      - --name={{ .Site.Name }}
      - --data-dir=/var/lib/etcd
      - --listen-peer-urls=http://{{ .Site.Address }}:2380
      - --listen-client-urls=http://{{ .Site.Address }}:2379,http://127.0.0.1:2379
      - --initial-advertise-peer-urls=http://{{ .Site.Address }}:2380
      - --advertise-client-urls=http://{{ .Site.Address }}:2379
      - --initial-cluster={{ .EtcdInitialCluster }}
      - --initial-cluster-state=new
      - --initial-cluster-token={{ .Scope }}
      # Measured from real round trip through the tunnel, not guessed. The
      # defaults assume one datacenter and produce phantom elections every
      # time a home connection hiccups.
      - --heartbeat-interval={{ .HeartbeatMS }}
      - --election-timeout={{ .ElectionTimeoutMS }}
    volumes:
      - /srv/infra/etcd:/var/lib/etcd
{{- end }}
{{- if .Site.IsData }}
  patroni:
    image: ghcr.io/zalando/spilo-{{ .PostgresVersion }}:{{ .SpiloTag }}
    restart: unless-stopped
    network_mode: host
    env_file:
      - patroni.env
    volumes:
      - /srv/infra/postgres:/home/postgres/pgdata
    # Fencing needs the watchdog, and there is exactly one Patroni per data
    # bearing host, so there is exactly one claimant for the device.
    devices:
      - /dev/watchdog:/dev/watchdog
{{- end }}
{{- if .Site.NeedsProxy }}
  haproxy:
    image: haproxy:3.0-alpine
    restart: unless-stopped
    network_mode: host
    volumes:
      - /srv/infra/haproxy/haproxy.cfg:/usr/local/etc/haproxy/haproxy.cfg:ro
{{- end }}
{{- if .Site.IsGarage }}
  garage:
    image: dxflrs/garage:v1.0.1
    restart: unless-stopped
    network_mode: host
    volumes:
      - /srv/infra/garage/garage.toml:/etc/garage.toml:ro
      - /srv/infra/garage/meta:/var/lib/garage/meta
      - /srv/infra/garage/data:/var/lib/garage/data
{{- end }}
{{- if .Site.IsGateway }}
  caddy:
    image: {{ .CaddyImage }}
    restart: unless-stopped
    network_mode: host
    env_file:
      - caddy.env
    volumes:
      - /srv/infra/caddy/Caddyfile:/etc/caddy/Caddyfile:ro
      # One file per application, imported by that application's host block.
      - /srv/infra/caddy/snippets:/etc/caddy/snippets:ro
      - /srv/infra/caddy/data:/data
      - /srv/infra/caddy/config:/config
{{- end }}
