# Rendered by paisans. Do not edit: `paisans apply` overwrites this file.
#
# Infrastructure for site {{ .Site.Name }}. Bind mounts under /srv, never named
# volumes, so relocating a stack is a tar rather than a volumes-from dance.
name: paisans-infra

services:
{{- if .Site.IsEtcd }}
  etcd:
    image: gcr.io/etcd-development/etcd:v3.5.16
    restart: unless-stopped
    network_mode: host
    command:
      - /usr/local/bin/etcd
      - --name={{ .Site.Name }}
      - --data-dir=/var/lib/etcd
      - --listen-peer-urls=http://{{ .Site.Address }}:{{ .EtcdPeerPort }}
      - --listen-client-urls=http://{{ .Site.Address }}:{{ .EtcdClientPort }},http://127.0.0.1:{{ .EtcdClientPort }}
      - --initial-advertise-peer-urls=http://{{ .Site.Address }}:{{ .EtcdPeerPort }}
      - --advertise-client-urls=http://{{ .Site.Address }}:{{ .EtcdClientPort }}
{{- /* Both flags are read on this member's first start only, and are
        repeated from /srv/infra/etcd-initial ever after, so a cluster that
        grows never changes them on a member already running. A template
        comment rather than a YAML one: a new line in this file would change
        the compose file of every deployment applied before it, and apply
        recreates the stack for that. */}}
      - --initial-cluster={{ .EtcdInitialCluster }}
      - --initial-cluster-state={{ .EtcdInitialState }}
      - --initial-cluster-token={{ .Scope }}
      # Measured from real round trip through the tunnel, not guessed. The
      # defaults assume one datacenter and produce phantom elections every
      # time a home connection hiccups.
      - --heartbeat-interval={{ .HeartbeatMS }}
      - --election-timeout={{ .ElectionTimeoutMS }}
{{- /* Runtime flags, read on every start, unlike the initial-cluster pair
        above: changing them recreates this member and nothing else. See
        etcdCompactionRetention and etcdQuotaBackendBytes in
        internal/render/etcd.go for the values and their reasons. */}}
      - --auto-compaction-mode=periodic
      - --auto-compaction-retention={{ .EtcdCompactionRetention }}
      - --quota-backend-bytes={{ .EtcdQuotaBackendBytes }}
    volumes:
      - /srv/infra/etcd:/var/lib/etcd
{{- end }}
{{- if .Site.IsData }}
  patroni:
    image: ghcr.io/zalando/spilo-{{ .PostgresVersion }}:{{ .SpiloTag }}
    restart: unless-stopped
    network_mode: host
    env_file:
      - patroni.env
    volumes:
      - /srv/infra/postgres:/home/postgres/pgdata
{{- if not .Site.WatchdogOff }}
    # Fencing needs the watchdog, and there is exactly one Patroni per data
    # bearing host, so there is exactly one claimant for the device.
    devices:
      - /dev/watchdog:/dev/watchdog
    # Spilo starts Patroni as postgres through chpst, which keeps only the
    # primary group, so a root owned 0600 node is unusable and Patroni in
    # required mode never takes the leader. Docker makes the container its own
    # device node, so owning that copy changes nothing on the host. The image's
    # own CMD follows unchanged. Widening the host's node instead (a udev
    # rule) was tried first and rejected: chpst drops the group it relied on,
    # and any mode wide enough would let every local user arm the timer.
    command: ["/bin/sh", "-c", "chown postgres /dev/watchdog && exec /bin/sh /launch.sh init"]
{{- end }}
{{- end }}
{{- if .Site.NeedsProxy }}
  haproxy:
    image: haproxy:3.0-alpine
    restart: unless-stopped
    network_mode: host
    volumes:
      - /srv/infra/haproxy/haproxy.cfg:/usr/local/etc/haproxy/haproxy.cfg:ro
{{- end }}
{{- if .Site.IsGarage }}
  garage:
    image: dxflrs/garage:v1.0.1
    restart: unless-stopped
    network_mode: host
    volumes:
      - /srv/infra/garage/garage.toml:/etc/garage.toml:ro
      - /srv/infra/garage/meta:/var/lib/garage/meta
      - /srv/infra/garage/data:/var/lib/garage/data
{{- end }}
{{- if .Site.RunsCaddy }}
  caddy:
    image: {{ .CaddyImage }}
    restart: unless-stopped
    network_mode: host
    # Relative to this file, so the path names the caddy/ directory the token
    # is rendered into. The token stays out of this file because compose.yaml
    # is 0644 and readable by anything that can list the stack.
    env_file:
      - caddy/caddy.env
    volumes:
      - /srv/infra/caddy/Caddyfile:/etc/caddy/Caddyfile:ro
      # One file per application, imported by that application's host block.
      - /srv/infra/caddy/snippets:/etc/caddy/snippets:ro
      - /srv/infra/caddy/data:/data
      - /srv/infra/caddy/config:/config
{{- end }}
