# Rendered by paisans. Do not edit: `paisans apply` overwrites this file.
#
# wg0 exists from the first install, with an empty peer list at one site.
# Every service binds to this address, so joining a site only adds peers: no
# service is reconfigured and no address changes.
[Interface]
Address = {{ .Site.Address }}/{{ .MeshPrefix }}
ListenPort = 51820
PrivateKey = {{ .PrivateKey }}
{{- if .IsRelay }}
# This site has a stable endpoint, so it relays traffic between sites that
# have none. Both homes are behind NAT with changing addresses and neither can
# dial the other.
PostUp = sysctl -w net.ipv4.ip_forward=1
{{- end }}
{{- range .Peers }}

[Peer]
# {{ .Name }}
PublicKey = {{ .PublicKey }}
AllowedIPs = {{ .AllowedIPs }}
{{- if .Endpoint }}
Endpoint = {{ .Endpoint }}
# Keeps the NAT mapping open from the side that dials out.
PersistentKeepalive = 25
{{- end }}
{{- end }}
