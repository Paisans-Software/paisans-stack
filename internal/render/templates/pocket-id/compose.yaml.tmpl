# Rendered by paisans. Do not edit: `paisans apply` overwrites this file.
#
# The identity provider gates every other application, so it holds no state of
# its own that a promoted site would lack: its uploads go in the database
# rather than on disk, where they ride streaming replication with no sync job.
{{- if .App.Pinned }}
#
# Pinned to {{ .App.Site }}: its own database, at its own site.
{{- end }}
name: paisans-{{ .App.Name }}

services:
  app:
    image: {{ .Image "app" }}
    restart: unless-stopped
    # The standby wrapper, paisans-standby.sh beside this file, runs the
    # image's own entrypoint and command, which are spelled out here because
    # setting an entrypoint clears the image's command. Pocket ID admits one
    # instance per database, so on every apps site but one it stands by,
    # healthy, and retries every PAISANS_STANDBY_RETRY seconds (default 15).
    entrypoint: ["/bin/sh", "/paisans/pocket-id-standby.sh"]
    command: ["/app/docker/entrypoint.sh", "/app/pocket-id"]
    # The image's healthcheck (`/app/pocket-id healthcheck`, docker/
    # Dockerfile-prebuilt:20 at tag v2.14.0), passed by a standby through its
    # state file. Its timing is stated rather than inherited: the image checks
    # every 90s, which is also how long apply's gate would wait for a first
    # report, and a check that is a stat or one local request costs nothing.
    healthcheck:
      test: ["CMD-SHELL", "[ -f /tmp/paisans-standby ] || /app/pocket-id healthcheck"]
      interval: 30s
      timeout: 5s
      start_period: 30s
      start_interval: 5s
      retries: 3
    # Long enough for a clean shutdown, which halts the actors (a 10s grace,
    # backend/internal/bootstrap/actors_bootstrap.go:60) and then deregisters
    # this instance, so a standby takes over at its next retry. Docker's
    # default of 10s would kill it first and leave the registration to age out
    # over 90s.
    stop_grace_period: 30s
    env_file:
      - .env
    # The mesh address only. Docker's own iptables rules bypass a host
    # firewall, so a port published on every interface of a host with a
    # public address is reachable from the internet whatever ufw says. The
    # gateway, over the mesh, is the only thing that should reach it.
    ports:
      - "{{ .MeshAddress }}:{{ .App.Port }}:{{ .App.Port }}"
    volumes:
      - {{ .DataPath }}/data:/app/data
      - {{ .DataPath }}/paisans-standby.sh:/paisans/pocket-id-standby.sh:ro
{{- if .App.Pinned }}
    depends_on:
      - postgres

  postgres:
    image: {{ .Image "postgres" }}
    restart: unless-stopped
    environment:
      POSTGRES_DB: {{ .DBName }}
      POSTGRES_USER: {{ .DBUser }}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:?set in .env}
    volumes:
      - {{ .DataPath }}/postgres:{{ .PostgresDataMount }}
{{- end }}
