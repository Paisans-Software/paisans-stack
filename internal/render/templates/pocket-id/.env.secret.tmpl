# Rendered by paisans. Do not edit.
#
# A build artifact: `paisans apply` renders it and refuses to overwrite one
# that has been modified locally. Change paisans.yaml or secrets.enc.yaml.
#
# Every name below was read from Pocket ID's source at tag v2.14.0,
# backend/internal/common/env_config.go, which is the whole of its
# environment.
PAISANS_APP={{ .App.Name }}
PAISANS_SITE={{ .App.Site }}
APP_URL={{ .PublicURL }}
# The mesh subnet, never `true`. `true` trusts 0.0.0.0/0 and ::/0
# (env_config.go:425-437), so any client that reached the port could choose
# the address Pocket ID logs and rate limits. The port is bound to the mesh
# address only, so the subnet is exactly the set of proxies there can be.
TRUST_PROXY={{ .TrustedProxies }}
# Required: Pocket ID refuses to start with one shorter than 16 bytes
# (env_config.go:167-169). It encrypts stored secrets and derives the key the
# instance's own hosts authenticate each other with, so changing it after the
# first start is a migration, not a setting, and `init` never replaces it.
ENCRYPTION_KEY={{ .Secret "encryption_key" }}
# How the toolkit reaches the admin API without a browser: a request whose
# X-API-Key header equals this authenticates as a synthetic administrator
# (apikey/service.go:156-163, :221-259). It never leaves the workstation
# except to land here: `paisans app admin create` and `paisans oidc client
# create` send it to curl on this host over ssh, on stdin, and the admin
# reconciler in this stack reads it from this file.
STATIC_API_KEY={{ .Secret "static_api_key" }}
# Where the admin reconciler reaches Pocket ID: the app service, on this stack's
# own network.
PAISANS_RECONCILER_POCKET_ID=http://app:{{ .App.Port }}
# There is no DB_PROVIDER: Pocket ID reads the provider from this URL's scheme
# (env_config.go:213-223), so a separate variable would be ignored.
DB_CONNECTION_STRING={{ .DSN }}
{{- if .App.Pinned }}
POSTGRES_PASSWORD={{ .DBPassword }}
{{- end }}
# `database` keeps avatars and admin branding, about a megabyte in total, on
# streaming replication, so a promoted site already has them. On `filesystem`
# they are node local: a promotion serves broken avatars and stock branding in
# the middle of an incident.
FILE_BACKEND={{ .Setting "file_backend" "database" }}
# Pocket ID's application configuration comes from this file and nowhere
# else. With UI_CONFIG_DISABLED=true it reads every setting from the
# environment at startup and ignores what its database holds
# (appconfig/service.go:33-40, :205-249), and its admin page for them is read
# only. A variable below that is absent takes Pocket ID's own default. Change
# apps.{{ .App.Name }}.settings in paisans.yaml and apply, which restarts it;
# a value Pocket ID would refuse is refused by `paisans validate` first.
UI_CONFIG_DISABLED=true
{{- range .PocketID.Env }}
{{ .Name }}={{ .Value }}
{{- end }}
{{- if .PocketID.Unresolved }}
# signup_default_groups names {{ range $i, $g := .PocketID.Unresolved }}{{ if $i }}, {{ end }}{{ $g }}{{ end }}, with no ID recorded under
# pocket_id_groups yet. `paisans apply` on a site running Pocket ID resolves
# each name at the running instance, records the ID and renders this again.
{{- end }}
{{- if .SMTP.Host }}
# Mail, from the deployment's smtp block with this app's own smtp fields over
# it. Pocket ID has no sender name setting: its mail goes out as APP_NAME
# (email/module.go:212).
SMTP_HOST={{ envquote .SMTP.Host }}
SMTP_PORT={{ .SMTP.Port }}
SMTP_TLS={{ if .SMTP.Secure }}tls{{ else }}starttls{{ end }}
{{- if .SMTP.Username }}
SMTP_USER={{ envquote .SMTP.Username }}
{{- end }}
{{- if .SMTP.Password }}
SMTP_PASSWORD={{ envquote .SMTP.Password }}
{{- end }}
{{- if .SMTP.FromAddress }}
SMTP_FROM={{ envquote .SMTP.FromAddress }}
{{- end }}
{{- end }}
