# Rendered by paisans. Do not edit.
#
# A build artifact: `paisans apply` renders it and refuses to overwrite one
# that has been modified locally. Change paisans.yaml or secrets.enc.yaml.
PAISANS_APP={{ .App.Name }}
PAISANS_SITE={{ .App.Site }}
APP_URL={{ .PublicURL }}
TRUST_PROXY=true
DB_PROVIDER=postgres
DB_CONNECTION_STRING={{ .DSN }}
{{- if .App.Pinned }}
POSTGRES_PASSWORD={{ .DBPassword }}
{{- end }}
# `database` keeps avatars and admin branding, about a megabyte in total, on
# streaming replication, so a promoted site already has them. On `filesystem`
# they are node local: a promotion serves broken avatars and stock branding in
# the middle of an incident.
FILE_BACKEND={{ .Setting "file_backend" "database" }}
