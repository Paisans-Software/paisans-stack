# Rendered by paisans. Do not edit: `paisans apply` overwrites this file.
#
# The uptime monitor, pinned to {{ .App.Site }}. Its monitors are not configured
# here or in its UI: they are seeded from monitors.json, which `apply` renders
# from paisans.yaml, at every start.
#
# OWNERSHIP. It starts as root on purpose. data/ is a bind mount Docker
# creates as root, and monitors.json is a root owned 0600 file because it
# carries the SMTP password. The fork's entrypoint (from 1.1.0-oidc.2) hands
# both to `node` and drops to it for good. An older image ignores the seed and
# simply runs as root.
name: {{ .Project }}

services:
  app:
    labels:
      {{ .DeploymentLabel }}: "{{ .DeploymentID }}"
    image: {{ .Image "app" }}
    restart: unless-stopped
    user: "0:0"
    # The image declares its own healthcheck on /healthz (Dockerfile at
    # 1.1.0-oidc.3), which apply's health gate reads.
    env_file:
      - .env
    # ICMP for the per site ping checks.
    cap_add:
      - NET_RAW
{{- if .IngressListen }}
    # Published on sites.{{ .App.Site }}.ingress.listen alone, where the
    # operator's own web server proxies to. Nothing dials the mesh address:
    # the gateway does not route this app and the monitor does not check its
    # own container. Docker's own iptables rules bypass a host firewall, which
    # is why validate accepts only a loopback or private listen.
    ports:
      - "{{ .IngressListen }}:{{ .App.Port }}"
{{- else }}
    # The mesh address only, where the Caddy on this site reaches it. Docker's
    # own iptables rules bypass a host firewall, so a port published on every
    # interface of a host with a public address is reachable from the
    # internet whatever ufw says.
    ports:
      - "{{ .MeshAddress }}:{{ .App.Port }}:{{ .App.Port }}"
{{- end }}
    volumes:
      - {{ .DataPath }}/data:/data
      - {{ .DataPath }}/monitors.json:/seed/monitors.json:ro

# Every network carries the deployment label too, so that what owns it is
# read from the label rather than guessed from its name.
networks:
  default:
    labels:
      {{ .DeploymentLabel }}: "{{ .DeploymentID }}"
{{- if .IngressNetwork }}
    # Pinned, so the address the web server's connections arrive from
    # through Docker's publish is this network's gateway, which TRUST_PROXY
    # names.
    ipam:
      config:
        - subnet: {{ .IngressNetwork }}
          gateway: {{ .IngressGateway }}
{{- end }}
