# Rendered by paisans. Do not edit: `paisans apply` overwrites this file.
#
# The cluster runs from the first install, at one node, because converting a
# plain Postgres into a Patroni cluster later is a migration performed on live
# member data rather than an addition.
#
# Two vocabularies, on purpose. Spilo writes Patroni's configuration file from
# its own variables (postgres-appliance/scripts/configure_spilo.py at zalando/
# spilo 550c5d8), so the scope, the DCS and every role are given in Spilo's
# names. Patroni then reads PATRONI_* from the environment and lets them
# override that file, which is how the listen addresses are pinned to the mesh.
# Giving Spilo only PATRONI_* names was tried on a real host and fails: it sees
# no DCS of its own, starts an embedded etcd on 127.0.0.1:2379, collides with
# the real one, and Patroni follows the embedded one (configure_spilo.py
# lines 1143-1145).
SCOPE={{ .Scope }}
ETCD3_HOSTS={{ .EtcdClientHosts }}
PATRONI_NAME={{ .Site.Name }}
RESTAPI_CONNECT_ADDRESS={{ .Site.Address }}:{{ .PatroniAPIPort }}
PG_CONNECT_ADDRESS={{ .Site.Address }}:{{ .PostgresPort }}
PATRONI_RESTAPI_LISTEN={{ .Site.Address }}:{{ .PatroniAPIPort }}
PATRONI_POSTGRESQL_LISTEN={{ .Site.Address }},127.0.0.1:{{ .PostgresPort }}
PGUSER_SUPERUSER=postgres
PGPASSWORD_SUPERUSER={{ .SuperuserPassword }}
PGUSER_STANDBY=standby
PGPASSWORD_STANDBY={{ .StandbyPassword }}
{{- /* Setting PGPASSWORD_ADMIN is what makes Spilo create the admin role, with
        createrole and createdb, at bootstrap. */}}
PGUSER_ADMIN=admin
PGPASSWORD_ADMIN={{ .AdminPassword }}
{{- /* synchronous_mode costs a round trip per commit and is what stops a
        failover from losing acknowledged writes. It is cluster wide DCS
        configuration rather than a Spilo variable, so it reaches Patroni's
        bootstrap section through SPILO_CONFIGURATION, which Spilo merges
        beneath its own template. */}}
SPILO_CONFIGURATION={bootstrap: {dcs: {synchronous_mode: {{ .Synchronous }}, synchronous_mode_strict: {{ .SynchronousStrict }}}}}
{{- /* off is declared per site with `watchdog: off`, and validate warns about
        it. Every other mode means `host prepare` provided a device. */}}
PATRONI_WATCHDOG_MODE={{ if .Site.WatchdogOff }}off{{ else }}required{{ end }}
