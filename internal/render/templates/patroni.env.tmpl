# Rendered by paisans. Do not edit: `paisans apply` overwrites this file.
#
# The cluster runs from the first install, at one node, because converting a
# plain Postgres into a Patroni cluster later is a migration performed on live
# member data rather than an addition.
#
# Everything here is in Spilo's vocabulary, and none of it in Patroni's
# PATRONI_* names, because Spilo starts Patroni with almost no environment:
# its runit script (postgres-appliance/runit/patroni/run at zalando/spilo
# 550c5d8) unsets every variable but a short allowlist before exec. A
# PATRONI_* variable never reaches Patroni. The first real host ran that way:
# member name, listen addresses and watchdog mode were all silently ignored.
#
# What Spilo does read is its own variables, which it renders into Patroni's
# configuration file, and SPILO_CONFIGURATION, a YAML document it merges with
# that file. For a scalar both define, SPILO_CONFIGURATION wins (deep_update in
# configure_spilo.py), which is how the name and the addresses are pinned.
SCOPE={{ .Scope }}
{{- /* Declaring a DCS is also what stops Spilo starting an embedded etcd on
        127.0.0.1:2379, which collides with the real one on a host networked
        site (configure_spilo.py lines 1143-1145). */}}
ETCD3_HOSTS={{ .EtcdClientHosts }}
PGUSER_SUPERUSER=postgres
PGPASSWORD_SUPERUSER={{ .SuperuserPassword }}
PGUSER_STANDBY=standby
PGPASSWORD_STANDBY={{ .StandbyPassword }}
{{- /* Setting PGPASSWORD_ADMIN is what makes Spilo create the admin role, with
        createrole and createdb, at bootstrap. */}}
PGUSER_ADMIN=admin
PGPASSWORD_ADMIN={{ .AdminPassword }}
{{- /* One line of flow YAML, because an env file holds one value per line.
        name is the site's name, since apply finds the leader by it; Spilo's
        own default is the machine's hostname.
        Every listener is on the mesh address and loopback, never on all
        interfaces: Spilo's template listens on every interface.
        bg_mon moves off 8080, which applications use.
        synchronous_mode costs a round trip per commit and is what stops a
        failover from losing acknowledged writes; it is bootstrap DCS
        configuration rather than a Spilo variable.
        watchdog off is declared per site with `watchdog: off`, and validate
        warns about it. Every other mode means `host prepare` provided a
        device Patroni can open. */}}
SPILO_CONFIGURATION={name: {{ .Site.Name }}, restapi: {listen: '{{ .Site.Address }}:{{ .PatroniAPIPort }}', connect_address: '{{ .Site.Address }}:{{ .PatroniAPIPort }}'}, postgresql: {listen: '{{ .Site.Address }},127.0.0.1:{{ .PostgresPort }}', connect_address: '{{ .Site.Address }}:{{ .PostgresPort }}', parameters: {bg_mon.listen_address: '{{ .Site.Address }}', bg_mon.port: {{ .BgMonPort }}}}, watchdog: {mode: {{ if .Site.WatchdogOff }}'off'{{ else }}required{{ end }}}, bootstrap: {dcs: {synchronous_mode: {{ .Synchronous }}, synchronous_mode_strict: {{ .SynchronousStrict }}}}}
