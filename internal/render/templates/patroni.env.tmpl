# Rendered by paisans. Do not edit: `paisans apply` overwrites this file.
#
# The cluster runs from the first install, at one node, because converting a
# plain Postgres into a Patroni cluster later is a migration performed on live
# member data rather than an addition.
PATRONI_SCOPE={{ .Scope }}
PATRONI_NAME={{ .Site.Name }}
PATRONI_ETCD3_HOSTS={{ .EtcdClientHosts }}
PATRONI_RESTAPI_LISTEN={{ .Site.Address }}:{{ .PatroniAPIPort }}
PATRONI_RESTAPI_CONNECT_ADDRESS={{ .Site.Address }}:{{ .PatroniAPIPort }}
PATRONI_POSTGRESQL_LISTEN={{ .Site.Address }},127.0.0.1:{{ .PostgresPort }}
PATRONI_POSTGRESQL_CONNECT_ADDRESS={{ .Site.Address }}:{{ .PostgresPort }}
PATRONI_SUPERUSER_USERNAME=postgres
PATRONI_SUPERUSER_PASSWORD={{ .SuperuserPassword }}
PATRONI_REPLICATION_USERNAME=standby
PATRONI_REPLICATION_PASSWORD={{ .StandbyPassword }}
PATRONI_admin_PASSWORD={{ .AdminPassword }}
PATRONI_admin_OPTIONS=createdb,createrole
{{- /* synchronous_mode costs a round trip per commit and is what stops a
        failover from losing acknowledged writes. */}}
SYNCHRONOUS_MODE={{ .Synchronous }}
SYNCHRONOUS_MODE_STRICT={{ .SynchronousStrict }}
PATRONI_WATCHDOG_MODE=required
