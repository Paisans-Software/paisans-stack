# Rendered by paisans. Do not edit.
#
# This file is a build artifact. `paisans apply` renders it and refuses to
# overwrite one that has been modified locally, so an edit here is lost work at
# best. Change paisans.yaml or secrets.enc.yaml instead.
#
# Changing a value means recreating the container. Compose passes environment
# at start, so `docker compose restart` will not pick it up.
#
# Every name below was read from the paisans fork at tag v1.13.3+paisans:
# .env.example_docker for the names and config/ for where each is used. The
# image bakes that example in as its own .env and compiles it at build time,
# so a value derived from another variable there (CORS_ALLOW_ORIGIN,
# MERCURE_PUBLIC_URL, REDIS_DNS, MESSENGER_TRANSPORT_DSN) still holds
# upstream's placeholder hostname and password. Each is therefore set here in
# full rather than left to be derived.
PAISANS_APP=talk
PAISANS_SITE=home-a
# The uid:gid the image's entrypoint chowns var/, /data and /config to and then
# runs as. The entrypoint reads it from the process environment, not from
# Symfony's, so without it the chown and the privilege drop both fail and the
# container exits.
MBIN_USER=1000:1000
KBIN_DOMAIN=talk.example.org
TRUSTED_PROXIES=10.44.0.0/24
APP_SECRET=fixture-not-a-secret-talk-app
CORS_ALLOW_ORIGIN='^https?://(talk\.example\.org|127\.0\.0\.1)(:[0-9]+)?$'

# Signed fetch, because this app is behind the visibility gate. The gate sends
# every ActivityPub request here without a session, so Mbin must refuse a read
# not signed by an instance on its allow list, and read only from those. An
# empty allow list federates with nobody until an admin adds a peer. These are
# read from here only until an admin saves Mbin's settings, after which the
# database wins; the monitor's signed fetch check is what notices one turned
# off there.
MBIN_AUTHORIZED_FETCH=true
MBIN_USE_FEDERATION_ALLOW_LIST=true

# The database. serverVersion is the cluster's major version; upstream marks
# it as one Doctrine must be told.
DATABASE_URL=postgresql://talk:fixture-not-a-secret-talk-db@10.44.0.1:5000/talk?serverVersion=18&charset=utf8

# Locks. LOCK_DSN is Symfony Lock's default store (config/packages/lock.yaml),
# and it stays flock, a lock file inside one container. Every rate limiter takes
# that default (framework-bundle v7.4.14, FrameworkExtension.php:3465-3466) on
# every vote, post and comment, in FrankenPHP's long lived web workers; a
# database store there would hold a private connection that Doctrine DBAL never
# reopens once HAProxy closes it, and every rate limited request would fail.
# Limiter state is in this site's own Valkey, so a lock across sites buys a
# limiter nothing.
#
# CLUSTER_LOCK_DSN is for the locks that must hold across every consumer on
# every site: the actor update lock and the scheduler lock. It is provisional:
# no paisans fork release reads it yet. The planned fork change gives those two
# a named `cluster` lock resource, an advisory lock store built on a Doctrine
# connection of its own that reconnects, which is why this is a plain
# postgresql:// URL to the same database as DATABASE_URL. Until an image that
# reads it is deployed, nothing does, and those locks stay on flock.
LOCK_DSN=flock
CLUSTER_LOCK_DSN=postgresql://talk:fixture-not-a-secret-talk-db@10.44.0.1:5000/talk?serverVersion=18&charset=utf8
# The queues, as rows in the database above (Symfony Messenger's Doctrine
# transport on the app's own connection), so work a site has accepted
# survives the site and every site's consumers share it. The paisans fork
# gives each transport in messenger.yaml its own queue_name and drops their
# AMQP options, which the Doctrine transport would refuse.
#
# check_delayed_interval is milliseconds. One consumer reads every queue over
# one session, and a LISTEN/NOTIFY wake-up taken by one queue's receiver is
# lost to the rest, which then wait for this poll (the default is a minute).
# redeliver_timeout is seconds: a message a dead consumer had taken is handed
# out again after it, instead of the default hour. It must stay longer than
# any handler runs.
MESSENGER_TRANSPORT_DSN=doctrine://default?check_delayed_interval=1000&redeliver_timeout=900

# The cache. compose.yaml passes VALKEY_PASSWORD on valkey's command line, and
# Symfony's cache reads REDIS_DNS (config/packages/cache.yaml), not the
# password on its own.
VALKEY_PASSWORD=fixture-not-a-secret-valkey
REDIS_DNS=redis://fixture-not-a-secret-valkey@valkey:6379

# Mercure, Mbin's live update hub, built into the same FrankenPHP image. The
# image's Caddyfile reads the two JWT keys; the application signs with
# MERCURE_JWT_SECRET. MERCURE_URL is how the application and the messenger
# consumers reach the hub, over this stack's own network by service name.
MERCURE_URL=http://app:8080/.well-known/mercure
MERCURE_PUBLIC_URL=https://talk.example.org/.well-known/mercure
MERCURE_JWT_SECRET=fixture-not-a-secret-mercure
MERCURE_PUBLISHER_JWT_KEY=fixture-not-a-secret-mercure
MERCURE_SUBSCRIBER_JWT_KEY=fixture-not-a-secret-mercure

# Mbin's own OAuth2 server, for API clients, which is not the sign in below.
# The two key paths are upstream's defaults; compose.yaml mounts oauth/ there.
# OAUTH_PASSPHRASE opens oauth/private.pem, which init generated encrypted
# with it.
OAUTH_PRIVATE_KEY=%kernel.project_dir%/config/oauth2/private.pem
OAUTH_PUBLIC_KEY=%kernel.project_dir%/config/oauth2/public.pem
OAUTH_PASSPHRASE=fixture-not-a-secret-talk-oauth-passphrase
OAUTH_ENCRYPTION_KEY=fixture-not-a-secret-talk-oauth-encryption

# Object storage. The image's entrypoint switches uploads to the S3 adapter
# when S3_KEY is set and APP_ENV is prod (the image's own default), in app and
# messenger alike. That is the only switch; nothing overrides the file it edits.
# S3_VERSION is the AWS SDK's API version, and upstream's S3 documentation
# sets it to latest.
S3_KEY=GK001122334455001122334455
S3_SECRET=00112233445566778899aabbccddeeff000112233445566778899aabbccddeef
S3_BUCKET=talk-uploads
S3_REGION=garage
S3_ENDPOINT=http://10.44.0.1:3900
S3_VERSION=latest
# Mbin builds every media URL and every Liip Imagine thumbnail root from this,
# so it is the public base rather than the endpoint uploads are written to. A
# federating instance caches what it finds here.
#
# This app's own media hostname, with no bucket in the path: the gateway
# resolves the bucket from the hostname, so the path is the object key.
KBIN_STORAGE_URL=https://talk-media.example.org
# Single sign on, pointed straight at the identity provider. Every endpoint is
# discovered from {issuer}/.well-known/openid-configuration, so the issuer is
# the only URL to set. The client's callback at the provider must be the
# fork's oauth_oidc_verify route,
#
#   https://talk.example.org/oauth/oidc/verify
#
# and the client must have PKCE enabled, because Mbin always sends a code
# challenge.
#
# The generic OIDC provider is the paisans fork's, which this kind's default
# image is. Upstream Mbin ships only named providers (keycloak, zitadel,
# authentik), so an app that declares an upstream image under `images` gets
# none of these variables read, and has no way to sign in through the provider.
OAUTH_OIDC_ISSUER=https://id.example.org
OAUTH_OIDC_ID=fixture-not-a-secret-talk-id
OAUTH_OIDC_SECRET=fixture-not-a-secret-talk-secret

# Set by `config` in paisans.yaml, not by a template.
KBIN_META_TITLE=A place to talk
