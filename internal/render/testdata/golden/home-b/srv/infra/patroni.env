# Rendered by paisans. Do not edit: `paisans apply` overwrites this file.
#
# The cluster runs from the first install, at one node, because converting a
# plain Postgres into a Patroni cluster later is a migration performed on live
# member data rather than an addition.
PATRONI_SCOPE=paisans
PATRONI_NAME=home-b
PATRONI_ETCD3_HOSTS=10.44.0.1:2379,10.44.0.2:2379,10.44.0.3:2379
PATRONI_RESTAPI_LISTEN=10.44.0.2:8008
PATRONI_RESTAPI_CONNECT_ADDRESS=10.44.0.2:8008
PATRONI_POSTGRESQL_LISTEN=10.44.0.2,127.0.0.1:5432
PATRONI_POSTGRESQL_CONNECT_ADDRESS=10.44.0.2:5432
PATRONI_SUPERUSER_USERNAME=postgres
PATRONI_SUPERUSER_PASSWORD=fixture-not-a-secret-superuser
PATRONI_REPLICATION_USERNAME=standby
PATRONI_REPLICATION_PASSWORD=fixture-not-a-secret-standby
PATRONI_admin_PASSWORD=fixture-not-a-secret-admin
PATRONI_admin_OPTIONS=createdb,createrole
SYNCHRONOUS_MODE=true
SYNCHRONOUS_MODE_STRICT=false
PATRONI_WATCHDOG_MODE=required
