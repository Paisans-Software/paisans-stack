# Rendered by paisans. Do not edit: `paisans apply` overwrites this file.
#
# The cluster runs from the first install, at one node, because converting a
# plain Postgres into a Patroni cluster later is a migration performed on live
# member data rather than an addition.
#
# Two vocabularies, on purpose. Spilo writes Patroni's configuration file from
# its own variables (postgres-appliance/scripts/configure_spilo.py at zalando/
# spilo 550c5d8), so the scope, the DCS and every role are given in Spilo's
# names. Patroni then reads PATRONI_* from the environment and lets them
# override that file, which is how the listen addresses are pinned to the mesh.
# Giving Spilo only PATRONI_* names was tried on a real host and fails: it sees
# no DCS of its own, starts an embedded etcd on 127.0.0.1:2379, collides with
# the real one, and Patroni follows the embedded one (configure_spilo.py
# lines 1143-1145).
SCOPE=paisans
ETCD3_HOSTS=10.44.0.1:2379,10.44.0.2:2379,10.44.0.3:2379
PATRONI_NAME=home-b
RESTAPI_CONNECT_ADDRESS=10.44.0.2:8008
PG_CONNECT_ADDRESS=10.44.0.2:5432
PATRONI_RESTAPI_LISTEN=10.44.0.2:8008
PATRONI_POSTGRESQL_LISTEN=10.44.0.2,127.0.0.1:5432
PGUSER_SUPERUSER=postgres
PGPASSWORD_SUPERUSER=fixture-not-a-secret-superuser
PGUSER_STANDBY=standby
PGPASSWORD_STANDBY=fixture-not-a-secret-standby
PGUSER_ADMIN=admin
PGPASSWORD_ADMIN=fixture-not-a-secret-admin
SPILO_CONFIGURATION={bootstrap: {dcs: {synchronous_mode: true, synchronous_mode_strict: false}}}
PATRONI_WATCHDOG_MODE=required
