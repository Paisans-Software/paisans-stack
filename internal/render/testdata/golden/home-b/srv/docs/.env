# Rendered by paisans. Do not edit.
#
# A build artifact: `paisans apply` renders it and refuses to overwrite one
# that has been modified locally. Change paisans.yaml or secrets.enc.yaml.
#
# Changing a value means recreating the container, since Compose passes
# environment at start.
PAISANS_APP=docs
PAISANS_SITE=home-b
URL=https://docs.example.org
TRUSTED_PROXIES=10.44.0.0/24
DATABASE_URL=postgresql://docs:fixture-not-a-secret-docs-db@10.44.0.2:5000/docs
FILE_STORAGE=s3
AWS_ACCESS_KEY_ID=GKaabbccddeeffaabbccddeeff
AWS_SECRET_ACCESS_KEY=aabbccddeeff0011aabbccddeeff0011aabbccddeeff0011aabbccddeeff0011
AWS_REGION=garage
AWS_S3_UPLOAD_BUCKET_NAME=docs-uploads
# Public, and load bearing for uploads as well as reads. Outline's server does
# not write bytes to S3 on a user's behalf: it issues a presigned POST that the
# browser submits directly against this URL, so it has to be browser reachable
# rather than the mesh endpoint. An upload here travels browser to gateway to
# Garage, not server to Garage the way Mbin's does.
#
# It is this app's own media hostname, which the gateway sends to Garage's S3
# API with Host unchanged, never to the anonymous web endpoint. Outline also
# uses it as its S3 client's endpoint, so it is the host every presigned URL
# is signed for.
AWS_S3_UPLOAD_BUCKET_URL=https://docs-media.example.org
# Path style, and here it is required rather than a preference. The media
# hostname is not under Garage's S3 root domain, so Garage reads the bucket
# from the path; virtual host style would put the bucket in a hostname
# (docs-uploads.docs-media.example.org) that has no DNS record, no
# certificate and no host block.
AWS_S3_FORCE_PATH_STYLE=true
# Outline takes each endpoint individually rather than discovering them.
OIDC_CLIENT_ID=fixture-not-a-secret-docs-id
OIDC_CLIENT_SECRET=fixture-not-a-secret-docs-secret
OIDC_AUTH_URI=https://id.example.org/authorize
OIDC_TOKEN_URI=https://id.example.org/api/oidc/token
OIDC_USERINFO_URI=https://id.example.org/api/oidc/userinfo
OIDC_USERNAME_CLAIM=preferred_username
OIDC_SCOPES=openid profile email
