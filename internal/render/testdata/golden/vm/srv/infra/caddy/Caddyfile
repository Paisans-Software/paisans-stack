# Rendered by paisans. Do not edit: `paisans apply` overwrites this file.
#
# Inventory driven: a pinned app's hostname points at its location, everything
# else is proxied to the sites holding the apps role. DNS-01 is used rather
# than HTTP-01, so a gateway can hold valid certificates before any DNS record
# points at it. That is what makes moving the gateway an overlap rather than a
# cutover.
{
	email admin@example.org
	acme_dns cloudflare {env.CLOUDFLARE_API_TOKEN}
}

chat.example.org {
	reverse_proxy 10.44.0.3:8008 {
		header_up X-Forwarded-Proto https
	}
}

docs.example.org {
	reverse_proxy 10.44.0.1:3000 10.44.0.2:3000 {
		# first, not round robin: the apps sites are not interchangeable
		# during a failover, and a dead one must simply be skipped.
		lb_policy first
		fail_duration 10s
		header_up X-Forwarded-Proto https
	}
}

id.example.org {
	reverse_proxy 10.44.0.1:1411 10.44.0.2:1411 {
		# first, not round robin: the apps sites are not interchangeable
		# during a failover, and a dead one must simply be skipped.
		lb_policy first
		fail_duration 10s
		header_up X-Forwarded-Proto https
	}
}

talk.example.org {
	reverse_proxy 10.44.0.1:8080 10.44.0.2:8080 {
		# first, not round robin: the apps sites are not interchangeable
		# during a failover, and a dead one must simply be skipped.
		lb_policy first
		fail_duration 10s
		header_up X-Forwarded-Proto https
	}
}
