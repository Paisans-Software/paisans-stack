# Rendered by paisans. Do not edit: `paisans apply` overwrites this file.
#
# Routing for docs, imported by the gateway's block for
# docs.example.org. Nothing about this application needs routing
# beyond the proxy itself, which is worth stating: a snippet that is plain is a
# fact about the application, not a file waiting to be filled in.
reverse_proxy 10.44.0.1:3000 10.44.0.2:3000 {
	# first, not round robin: the apps sites are not interchangeable during a
	# failover, and a dead one must simply be skipped.
	lb_policy first
	fail_duration 10s
	header_up X-Forwarded-Proto https
}
