# Rendered by paisans. Do not edit.
#
# Synapse's own configuration is homeserver.yaml, beside this file. What is
# here is the little the container itself needs: where that file is, and the
# password for the Postgres service in this stack's own compose file. This
# kind is pinned by design and internal/validate refuses any other placement,
# so that service is always here and the password is never conditional.
PAISANS_APP=chat
PAISANS_SITE=vm
SYNAPSE_CONFIG_PATH=/data/homeserver.yaml
POSTGRES_PASSWORD=fixture-not-a-secret-chat-db
