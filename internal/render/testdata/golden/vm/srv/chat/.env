# Rendered by paisans. Do not edit.
#
# This file is a build artifact. `paisans apply` renders it from paisans.yaml
# and secrets.enc.yaml and refuses to overwrite one that has been modified
# locally, so an edit here is lost work at best. Change the source instead.
#
# Changing a value means recreating the container. Compose passes environment
# at start, so `docker compose restart` will not pick it up.
PAISANS_APP=chat
PAISANS_SITE=vm
POSTGRES_DB=chat
POSTGRES_HOST=postgres
POSTGRES_PASSWORD=fixture-not-a-secret-chat-db
POSTGRES_PORT=5432
POSTGRES_USER=chat
SYNAPSE_MEDIA_STORE_PATH=/data/media_store
SYNAPSE_REPORT_STATS=no
SYNAPSE_SERVER_NAME=chat.example.org
TRUSTED_PROXIES=10.44.0.0/24
