# Written by paisans host prepare. Do not edit: it is rewritten if it differs.
#
# Docker starts after this deployment's mesh interface, {{ .Interface }}, so a container publishing a port on
# the site's mesh address can bind it at boot. Started first, Docker meets an
# address that does not exist yet ("cannot assign requested address"), and it
# does not retry a container that failed while setting up its network.
[Unit]
Wants={{ .Unit }}.service
After={{ .Unit }}.service
