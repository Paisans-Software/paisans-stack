# Never commit secrets or member data.
.env
.env.*
!.env.example

# The golden tree is rendered output, checked in so that a change to what
# lands on a host shows up as a reviewable diff. Its .env files are built from
# the fixture secrets, where every value is a fixed placeholder. Nothing real
# goes in this directory.
!internal/render/testdata/golden/**/.env

# A kind's template set is source, and the templates that render an .env are
# named for what they produce. The rule above matches them by accident, and the
# failure is silent in the worst way: the files stay on the machine that wrote
# them, tests pass there, and a fresh checkout renders no .env at all.
!internal/render/templates/**/.env*.tmpl
*.key
*.pem
secrets/

# A real deployment's config names real hosts. The toolkit repo ships only
# examples; a deployment keeps its own config directory elsewhere.
paisans.yaml
!examples/paisans.example.yaml

# secrets.enc.yaml IS meant to be committed — but only ever encrypted. Refuse
# the decrypted form outright: it is the one mistake with no undo once pushed.
secrets.yaml
secrets.dec.yaml
*.dec.yaml

# Worktrees live at .worktrees/<name>, inside the repo. Checkouts, not content.
.worktrees/

# Local state
out/
archive/
*.log
.DS_Store
